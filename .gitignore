.venv/
venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
frontend/dist/
*.tsbuildinfo

# Temp files from the append-only audit writer
output/*.tmp

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
